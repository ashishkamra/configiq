# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AISimulators API gateway — used by the app/api/ proxy routes (server-side).
# Powers /api/recommend, /api/estimate, /api/memory, /api/gpus and /api/catalog.
AISIMULATORS_GATEWAY_URL=https://aisimulators.dev
AISIMULATORS_TIMEOUT_SECONDS=90

# aicostings API gateway — used by the app/api/costings/ proxy routes
# (server-side). Powers the costings features (model pricing, GPU cloud rates,
# hardware costs) behind the costingsEnabled setting.
AICOSTINGS_GATEWAY_URL=https://aicostings.dev
AICOSTINGS_TIMEOUT_SECONDS=30

# Optional Qwen sizing agent. OFF until the model/runtime is qualified on the L4.
# One long-lived Node process only; not serverless or multiple replicas.
CONFIGIQ_AGENT_ENABLED=false
CONFIGIQ_AGENT_SINGLE_PROCESS=false
CONFIGIQ_AGENT_ORIGIN=http://localhost:3000
CONFIGIQ_AGENT_MODEL_BASE_URL=http://localhost:8000/v1
CONFIGIQ_AGENT_MODEL_ID=Qwen/Qwen3-VL-8B-Instruct-FP8
# Optional provenance only: set to the pinned revision actually deployed.
# This does not download, pin, or verify the running server's checkpoint.
# CONFIGIQ_AGENT_MODEL_REVISION=9cdc6310a8cb770ce18efaf4e9935334512aee45
CONFIGIQ_AGENT_MODEL_API_KEY=replace-with-private-serving-key
CONFIGIQ_AGENT_CONTEXT_TOKENS=4096
CONFIGIQ_AGENT_MODEL_CONCURRENCY=1
# Optional: only if the trusted ingress OVERWRITES this header on every request.
# CONFIGIQ_AGENT_CLIENT_IP_HEADER=x-real-ip

# Add future env vars here as features are added:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/gpu_calc
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3000
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
